{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["backend", "frontend", "postgres", "existingSecret"],
  "properties": {
    "namespace": {
      "type": "object",
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1, "maxLength": 63 },
        "labels": { "type": "object" }
      }
    },
    "backend": {
      "type": "object",
      "required": ["image", "replicas", "resources", "config"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 20 },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"],
          "properties": {
            "requests": { "type": "object" },
            "limits": { "type": "object" }
          }
        },
        "config": { "type": "object" }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["image", "replicas", "resources"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 20 },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"],
          "properties": {
            "requests": { "type": "object" },
            "limits": { "type": "object" }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "required": ["image", "storage", "resources"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "storage": { "type": "string", "minLength": 1 },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"],
          "properties": {
            "requests": { "type": "object" },
            "limits": { "type": "object" }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "host"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    },
    "networkPolicies": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    }
  }
}

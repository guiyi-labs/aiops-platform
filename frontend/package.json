{
  "name": "k8s-aiops-console",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "typegen": "openapi-typescript ../docs/api/openapi.yaml -o src/api/openapi.d.ts",
    "bundle:gate": "node scripts/bundle-gate.mjs",
    "test:e2e": "playwright test",
    "perf:bundle": "node scripts/login-bundle-analyze.mjs",
    "perf:sample": "node scripts/login-perf-sample.mjs",
    "perf:report": "node scripts/login-perf-report.mjs",
    "perf:login": "pnpm perf:sample && pnpm perf:bundle && pnpm perf:report",
    "perf:pods:sample": "node scripts/pod-scale-perf-sample.mjs",
    "perf:pods:report": "node scripts/pod-scale-perf-report.mjs",
    "perf:pods": "pnpm perf:pods:sample && pnpm perf:pods:report",
    "style:audit": "node scripts/style-audit.mjs",
    "ui:gate": "node ../scripts/ui-gate.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "^0.525.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.42",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.14",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11"
  }
}
